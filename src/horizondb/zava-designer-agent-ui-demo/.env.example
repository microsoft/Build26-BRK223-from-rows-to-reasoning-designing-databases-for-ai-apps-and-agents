# Copy this file to `.env` and fill in your HorizonDB / PostgreSQL credentials.
# `.env` is gitignored — never commit real credentials.

# HorizonDB / PostgreSQL connection
PGHOST=your-instance.uksouth.horizondb.azure.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=your-username
PGPASSWORD=your-password

# Optional: backend port (defaults to 3001)
# PORT=3001
