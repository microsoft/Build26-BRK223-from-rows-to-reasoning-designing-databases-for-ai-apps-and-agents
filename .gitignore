# build26-repo-template

Template files will not be tracked by git.
*.bak
*.tmp

# Source materials folder — contents excluded, README tracked
_remove-before-publish/*
!_remove-before-publish/README.md

# OS files
.DS_Store
Thumbs.db

# IDE files (except .vscode/mcp.json which we want)
.idea/
*.swp
*.swo

# Environment files with secrets
.env
.env.local
.env.*.local

# Dependencies (if applicable)
node_modules/
__pycache__/
*.pyc
.venv/

# Run logs (e.g. Prep-Cloud-*.ps1 transcripts dropped into src/sql/azure/)
*.log

# Per-user VS Code workspace files (e.g. Build26-BRK223_bw.code-workspace)
*.code-workspace

# .NET build outputs
bin/
obj/
[Pp]ublish/
*.user
*.suo

# Cloud-deploy intermediates (Prep-Cloud-Hosting.ps1 outputs Blazor publish here)
src/sql/azure/hosting/blazor-publish/

src/horizondb/demo-sql/setup/ai-pipelines-setup.sql
src/horizondb/private